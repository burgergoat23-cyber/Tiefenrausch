# Kopiere diese Datei zu ".env" und trag deine Werte ein. ".env" kommt nie zu GitHub.

# Phase 1 – Jamendo (kostenlos, devportal.jamendo.com → eigene App → "Client ID")
# Du kannst die Client-ID auch direkt in der App unter Einstellungen → Quellen eintragen.
VITE_JAMENDO_CLIENT_ID=

# YouTube (offizieller Player) – Browser-API-Schlüssel aus der Google Cloud Console,
# dort auf die eigene Webseite und auf „YouTube Data API v3“ beschränken.
# Alternativ in der App unter Einstellungen → Musik-Quellen eintragen.
VITE_YOUTUBE_API_KEY=

# Phase 2 – Firebase (Konto + Sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Phase 3 – Spotify (nur Client-ID, NIE das Client Secret!)
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=
